# Server
SERVER_ADDR=:8080
APP_ENV=dev

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/omni_pixel?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_AUTO_MIGRATE=true

# Auth
JWT_SECRET=dev-insecure-secret-change-me
JWT_TTL=24h
JWT_ISSUER=omni-pixel
